generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// =====================================================
// SENveBEN PHASE 2 PLAN
// COUNTRY + LANGUAGE ALTYAPISI
// CANLI SCHEMA DEĞİLDİR
// =====================================================


// =====================================================
// COUNTRY (YENİ)
// =====================================================

model Country {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  cities City[]
  users  User[]

  @@index([code])
}


// =====================================================
// CITY (MEVCUT + COUNTRY EKİ)
// =====================================================

model City {
  id   Int    @id @default(autoincrement())
  name String

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])

  districts District[]
  users     User[]

  @@index([countryId])
}


// =====================================================
// DISTRICT (MEVCUT YAPI KORUNUYOR)
// =====================================================

model District {
  id     Int    @id @default(autoincrement())
  name   String

  cityId Int
  city   City @relation(fields: [cityId], references: [id])

  users User[]
}


// =====================================================
// USER (SADELEŞTİRİLMİŞ PLAN)
// =====================================================

model User {

  id String @id @default(cuid())


  countryId Int?
  country Country? @relation(fields: [countryId], references: [id])


  cityId Int
  city City @relation(fields: [cityId], references: [id])


  districtId Int
  district District @relation(fields: [districtId], references: [id])


  spokenLanguages String[] @default([])

}