    value?: string,
  ): string {
    if (!value) {
      return "";
    }

    const date =
      new Date(value);

    if (
      Number.isNaN(
        date.getTime(),
      )
    ) {
      return "";
    }

    return date.toLocaleTimeString(
      lang === "EN" ? "en-US" : lang === "RU" ? "ru-RU" : lang === "AR" ? "ar-SA" : "tr-TR",
      {
        hour: "2-digit",
        minute: "2-digit",
      },
