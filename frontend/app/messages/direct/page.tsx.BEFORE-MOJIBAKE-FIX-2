  const [status, setStatus] = useState("");

  const handleSendMessage = async () => {
    if (!messageText.trim() || !targetUserId) {
      setStatus("LÃ¼tfen bir mesaj yazÄ±n.");
      return;
    }

    setStatus("MesajÄ±nÄ±z gÃ¶nderiliyor...");

    try {
      const token = localStorage.getItem("accessToken");

      if (!token) {
        setStatus("Oturumunuz bulunamadÄ±. LÃ¼tfen tekrar giriÅŸ yapÄ±n.");
        return;
      }

      // 1ï¸âƒ£ Ã–nce kullanÄ±cÄ±yla konuÅŸmayÄ± oluÅŸtur / mevcut konuÅŸmayÄ± getir
      const conversationResponse = await fetch(
